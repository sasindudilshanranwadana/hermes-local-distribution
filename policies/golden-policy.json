{
  "schema_version": 1,
  "settings": {
    "model.default": "auto",
    "model.provider": "custom:local-distribution",
    "providers.local-distribution.base_url": "http://127.0.0.1:8801/v1",
    "providers.local-distribution.api_key": "${HERMES_LOCAL_ROUTER_KEY}",
    "agent.max_turns": 180,
    "agent.verify_on_stop": true,
    "agent.reasoning_effort": "medium",
    "terminal.backend": "local",
    "terminal.home_mode": false,
    "terminal.timeout": 180,
    "compression.enabled": true,
    "compression.threshold": 0.72,
    "compression.target_ratio": 0.22,
    "compression.checkpoint_required": true,
    "compression.progress_notices": true,
    "compression.protect_last_n": 12,
    "prompt_caching.cache_ttl": "1h",
    "approvals.mode": "smart",
    "security.redact_secrets": true,
    "privacy.redact_pii": true,
    "memory.memory_enabled": true,
    "memory.user_profile_enabled": true,
    "memory.write_approval": true,
    "delegation.max_concurrent_children": 4,
    "delegation.max_iterations": 40,
    "delegation.subagent_auto_approve": false,
    "checkpoints.enabled": true,
    "checkpoints.max_snapshots": 30,
    "telemetry.shared_metrics": false,
    "updates.pre_update_backup": true,
    "updates.backup_keep": 5,
    "tools.tool_search": true
  },
  "toolsets": {
    "enable": [
      "terminal",
      "file",
      "coding",
      "web",
      "browser",
      "vision",
      "skills",
      "memory",
      "session_search",
      "delegation",
      "clarify",
      "todo"
    ],
    "disable": ["computer_use"]
  }
}
